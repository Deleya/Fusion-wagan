# =============================================================
# WAGAN — Variables d'environnement
# =============================================================
# Copier ce fichier en .env et remplir chaque valeur.
# NE JAMAIS commiter le fichier .env (il est dans .gitignore).
# =============================================================

# =============================================================
# PARTIE 1 : Variables d'origine (Clonage initial Wagan recette)
# =============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret-key

# --- Mode Debug (DJANGO_SECURITY) ---
# LOCAL  → DEBUG=True
# PROD   → DEBUG=False (obligatoire, active tous les en-têtes HTTPS)
DEBUG=True

# --- Hôtes autorisés (séparés par des virgules) ---
# LOCAL  → ALLOWED_HOSTS=*
# PROD   → ALLOWED_HOSTS=wagan.bakeli.tech,api.bakeli.tech
ALLOWED_HOSTS=*

# --- CORS : domaines frontend autorisés (séparés par des virgules) ---
# LOCAL  → laisser vide (fallback sur localhost:5173)
# PROD   → CORS_ALLOWED_ORIGINS=https://wagan.bakeli.tech
CORS_ALLOWED_ORIGINS=

# --- Base de Données ---
# LOCAL  → sqlite:///db.sqlite3
# PROD   → postgresql://user:password@host:5432/dbname
DATABASE=sqlite:///db.sqlite3

# --- API Bakeli ---
BAKELI_AI_URL=https://ai.bakeli.tech
BAKELI_AI_KEY=your_bakeli_ai_key_here

# =============================================================
# PARTIE 2 : Nouvelles variables ajoutées (Pipeline IA, Bot, etc.)
# =============================================================

# --- IA Groq (LLaMA) ---
GROQ_API_KEY=your_groq_api_key_here

# --- WhatsApp (Meta API) ---
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ADMIN_NUMBER=your_admin_phone_number_here
CONTACT_PHONE_NUMBER=+221 XX XXX XX XX

# --- Celery & Redis (Asynchronisme) ---
# LOCAL  → redis://localhost:6379/0
# PROD   → redis://redis:6379/0 (si Docker Compose)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Discord Alerts (CRM) ---
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_MENTION=@here

# --- Google OAuth2 (Authentification) ---
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your_google_oauth_client_id_here
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your_google_oauth_secret_here
FRONTEND_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
